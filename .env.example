# Snipe — Secrets (never commit .env to git)
TELEGRAM_TOKEN=your_telegram_bot_token_here
GROQ_API_KEY=your_groq_api_key_here

# Optional: full LinkedIn event details via Apify (https://console.apify.com/settings/integrations).
# Without it, LinkedIn events arrive as bare links.
APIFY_TOKEN=

# Optional: where the SQLite database lives (point this at a mounted volume on Railway)
# SNIPE_DB_PATH=/data/snipe.db
